[Unit]
Description=SSWC Telegram SHOP BOT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shopbot
Group=shopbot
WorkingDirectory=/opt/tg-shop-bot
Environment=NODE_ENV=production
Environment=SHOP_DATA_DIR=/opt/tg-shop-bot/data
Environment=SHOP_HOST=0.0.0.0
ExecStart=/usr/bin/node /opt/tg-shop-bot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tg-shop-bot

[Install]
WantedBy=multi-user.target
